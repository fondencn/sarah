{
  "name": "sarah.client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "run-script-os",
    "prebuild": "node replace-env-vars.js",
    "build": "ng build",
    "prebuild:prod": "node replace-env-vars.js",
    "build:prod": "ng build --prod",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prestart": "node aspnetcore-https",
    "start:windows": "ng serve --ssl --ssl-cert \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.pem\" --ssl-key \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.key\" --host=127.0.0.1",
    "start:default": "ng serve --ssl --ssl-cert \"$HOME/.aspnet/https/${npm_package_name}.pem\" --ssl-key \"$HOME/.aspnet/https/${npm_package_name}.key\" --host=127.0.0.1",
    "update-openapi": "node update-openapi-clients.js",
    "update-openapi:save": "node update-openapi-clients.js --save-specs",
    "generate-clients": "node update-openapi-clients.js",
    "update-api": "node update-openapi-clients.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.1",
    "@angular/common": "^18.2.1",
    "@angular/compiler": "^18.2.1",
    "@angular/core": "^18.2.1",
    "@angular/forms": "^18.2.1",
    "@angular/platform-browser": "^18.2.1",
    "@angular/platform-browser-dynamic": "^18.2.1",
    "@angular/router": "^18.2.1",
    "@fluentui/svg-icons": "^1.1.317",
    "@fluentui/web-components": "^2.6.1",
    "@types/bingmaps": "^7.0.25",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "angular-oauth2-oidc": "^17.0.2",
    "bingmaps": "^2.0.3",
    "bootstrap": "^5.3.3",
    "jest-editor-support": "*",
    "jquery": "^3.7.1",
    "popper.js": "^1.16.1",
    "run-script-os": "*",
    "rxjs": "~7.8.1",
    "tslib": "^2.7.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.1",
    "@angular/cli": "^18.2.1",
    "@angular/compiler-cli": "^18.2.1",
    "@types/bootstrap": "^5.2.10",
    "@types/jasmine": "~5.1.4",
    "@types/jquery": "^3.5.32",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "5.4"
  }
}
