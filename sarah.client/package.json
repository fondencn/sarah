{
  "name": "sarah.client",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "run-script-os",
    "prebuild": "node replace-env-vars.js",
    "build": "ng build",
    "prebuild:prod": "node replace-env-vars.js",
    "build:prod": "ng build --prod",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:windows": "ng serve --host=127.0.0.1",
    "start:default": "node -e \"const vars = Object.fromEntries(Object.entries(process.env).filter(([k]) => k.toLowerCase().startsWith('services__'))); console.log('[NG-SERVE-START] Services env vars:', vars);\" && ng serve --host=localhost",
    "update-openapi": "node update-openapi-clients.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.1",
    "@angular/common": "^18.2.1",
    "@angular/compiler": "^18.2.1",
    "@angular/core": "^18.2.1",
    "@angular/forms": "^18.2.1",
    "@angular/platform-browser": "^18.2.1",
    "@angular/platform-browser-dynamic": "^18.2.1",
    "@angular/router": "^18.2.1",
    "@fluentui/svg-icons": "^1.1.317",
    "@fluentui/web-components": "^2.6.1",
    "@fullcalendar/angular": "^6.1.20",
    "@fullcalendar/bootstrap5": "^6.1.20",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/rrule": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@types/leaflet": "^1.9.21",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "angular-oauth2-oidc": "^17.0.2",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.13.1",
    "jest-editor-support": "*",
    "jquery": "^3.7.1",
    "leaflet": "^1.9.4",
    "popper.js": "^1.16.1",
    "rrule": "^2.8.1",
    "run-script-os": "*",
    "rxjs": "~7.8.1",
    "tslib": "^2.7.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.1",
    "@angular/cli": "^18.2.1",
    "@angular/compiler-cli": "^18.2.1",
    "@types/bootstrap": "^5.2.10",
    "@types/jasmine": "~5.1.4",
    "@types/jquery": "^3.5.32",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "5.4"
  }
}
