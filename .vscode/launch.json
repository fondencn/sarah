{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Sarah AppHost (Aspire)",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/Sarah.AppHost/Sarah.AppHost.csproj"
        },
        {
            "name": "Attach to Sarah AppHost (.NET)",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "Attach to running Sarah service (.NET)",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "justMyCode": true,
            "requireExactSource": false
        },
        {
            "name": "Launch .NET Core (Sarah Server)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build sarah server",
            "program": "${workspaceFolder}/Sarah.Server/bin/Debug/net9.0/Sarah.Server.dll", // Adjust the path if necessary
            "args": [],
            "cwd": "${workspaceFolder}/Sarah.Server",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Sarah.Server/Views"
            }
        },
        {
            "type": "chrome",
            "request": "attach",
            "name": "Attach to Chrome",
            "url": "http://localhost:4200",
            "webRoot": "${workspaceFolder}/sarah.client"
        }
    ]
}