{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch .NET Core (Sarah Server)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build sarah server",
            "program": "${workspaceFolder}/Sarah.Server/bin/Debug/net8.0/Sarah.Server.dll", // Adjust the path if necessary
            "args": [],
            "cwd": "${workspaceFolder}/Sarah.Server",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Sarah.Server/Views"
            }
        },
        {
            "type": "chrome",
            "request": "attach",
            "name": "Attach to Chrome",
            "url": "https://localhost:4200",
            "webRoot": "${workspaceFolder}/sarah.client"
        }
    ]
}