# Sarah Smart Home - Environment Configuration Example
# Copy this file to .env and update with your own secure credentials

# Keycloak Admin Credentials
# WARNING: Change these default values before deployment!
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=ChangeMe_SecurePassword123!

# RabbitMQ Credentials
# WARNING: Change these default values before deployment!
RABBITMQ_USER=sarahuser
RABBITMQ_PASSWORD=ChangeMe_SecurePassword456!

# PostgreSQL Database Credentials
# WARNING: Change these default values before deployment!
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeMe_SecurePassword789!

# Notes:
# - Never commit the .env file with real credentials to version control
# - Use strong, unique passwords for production environments
# - Consider using a secrets management system for production (e.g., Azure Key Vault, AWS Secrets Manager)
