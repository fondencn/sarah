# Sarah Smart Home — Main Host (pi) Environment Configuration
# Copy this file to .env and fill in secure passwords before deploying.

# ─── Host identity ───────────────────────────────────────────────────
# Hostname or IP of this Raspberry Pi (used for CORS and service URLs)
PI_HOST=pi

# ─── Image registry / tag ───────────────────────────────────────────
# Leave REGISTRY=sarah for local images transferred via docker save/load
REGISTRY=sarah
TAG=latest

# ─── Timezone ────────────────────────────────────────────────────────
TZ=Europe/Berlin

# ─── Keycloak ────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin

# ─── RabbitMQ ────────────────────────────────────────────────────────
RABBITMQ_USER=sarah
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq

# ─── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_postgres

# ─── Z-Wave serial port (DeviceService) ─────────────────────────────
ZWAVE_SERIAL_PORT=/dev/ttyACM0

# ─── TheThingsNetwork (DeviceService, optional) ─────────────────────
TTN_API_KEY=

# ─── FritzBox credentials (PersonsService) ──────────────────────────
FRITZBOX_USERNAME=
FRITZBOX_PASSWORD=
FRITZBOX_HOST=192.168.178.1
FRITZBOX_HOST_IP=192.168.178.1

# ─── AzureOpenAI (RulesService – Semantic Kernel) ───────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_KEY=

# ─── OpenWeatherMap (MonitoringService) ──────────────────────────────
OPENWEATHER_API_KEY=

# ─── Email notifications (RulesService, optional) ───────────────────
SMTP_SENDER=
SMTP_SERVER=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=

# ─── Observability / Grafana (optional – requires --profile observability) ───
# Grafana admin login at http://pi:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana
