  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "sarah"
  ],
  "templating": {
    "list": [
      {
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "description": "Filters the overview charts and rate graphs",
        "includeAll": true,
        "label": "Overview filter",
        "multi": true,
        "name": "service",
        "query": {
          "label": "service_name",
          "queryType": "labelValues",
          "stream": ""
        },
        "refresh": 2,
        "type": "query"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "description": "Selects which service to tail in the log stream below",
        "includeAll": false,
        "label": "Log stream service",
        "multi": false,
        "name": "log_service",
        "query": {
          "label": "service_name",
          "queryType": "labelValues",
          "stream": ""
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "label": "Level",
        "multi": true,
        "name": "level",
        "options": [
          {
            "text": "trace",
            "value": "trace"
          },
          {
            "text": "debug",
            "value": "debug"
          },
          {
            "text": "info",
            "value": "information"
          },
          {
            "text": "warn",
            "value": "warning"
          },
          {
            "text": "error",
            "value": "error"
          },
          {
            "text": "critical",
            "value": "critical"
          }
        ],
        "type": "custom"
      }
    ]
  },
