      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "id": 14,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{service_name=\"$log_service\"} | logfmt | level=~\"$level\"",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Logs \u2014 $log_service",
      "type": "logs"
    }
