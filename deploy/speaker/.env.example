# Sarah Smart Home — Speaker Satellite Environment Configuration
# Copy this file to .env and fill in the values before deploying.
# Each speaker needs its own copy with a unique SPEAKER_LOCATION.

# ─── Main host connection ────────────────────────────────────────────
# Hostname or IP of the main Raspberry Pi running all services
PI_HOST=pi

# ─── Image registry / tag ───────────────────────────────────────────
REGISTRY=sarah
TAG=latest

# ─── RabbitMQ credentials (must match the main host) ────────────────
RABBITMQ_USER=sarah
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq

# ─── Azure Speech Service (required for voice recognition & TTS) ────
AZURE_SPEECH_KEY=CHANGE_ME_azure_speech_subscription_key
AZURE_SPEECH_REGION=westeurope

# ─── Speaker location (room name, unique per speaker) ───────────────
# Used by SpeechServer to identify which room this speaker is in
SPEAKER_LOCATION=Wohnzimmer

# ─── Hardware feature flags ─────────────────────────────────────────
# Set to false if the microphone hardware is missing or broken.
SPEECH_RECOGNITION_ENABLED=true
